# Local defaults. docker-compose overrides container-only paths and service URLs.
REPOLENS_ENV=development
REPOLENS_DATABASE_URL=sqlite:///./.repolens/repolens.sqlite
REPOLENS_WORKSPACE_ROOT=.repolens/repos
REPOLENS_QDRANT_URL=http://localhost:6333
REPOLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REPOLENS_EMBEDDING_BASE_URL=
REPOLENS_EMBEDDING_API_KEY=
REPOLENS_EMBEDDING_MODEL=
REPOLENS_EMBEDDING_DIMENSION=

REPOLENS_CHAT_BASE_URL=
REPOLENS_CHAT_API_KEY=
REPOLENS_CHAT_MODEL=
REPOLENS_CHAT_TEMPERATURE=0.2
REPOLENS_CHAT_TIMEOUT_SECONDS=60

REPOLENS_SAFE_STATIC_CHECK_ENABLED=false
REPOLENS_SAFE_STATIC_CHECK_ALLOWED_CHECKERS=python_ast_parse

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
OPENAI_API_KEY=
