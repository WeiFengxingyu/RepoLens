{"id":"review-001","type":"review","repository_key":"python_demo","question":"Review this token expiration change.","expected_files":["app/auth/tokens.py"],"expected_symbols":["validate_access_token"],"expected_answer_keywords":["expired","token","test"],"review_diff":"diff --git a/app/auth/tokens.py b/app/auth/tokens.py\n--- a/app/auth/tokens.py\n+++ b/app/auth/tokens.py\n@@ -18,7 +18,7 @@ def validate_access_token(token: str, now: datetime) -> TokenClaims:\n-    if claims.expires_at <= now:\n+    if claims.expires_at < now:\n         raise AuthError(\"token expired\")\n     return claims\n","tags":["review","auth"],"notes":"Boundary change in expiration check."}
{"id":"review-002","type":"review","repository_key":"python_demo","question":"Review this invoice discount change.","expected_files":["app/billing/invoices.py"],"expected_symbols":["calculate_invoice_total"],"expected_answer_keywords":["discount","negative","test"],"review_diff":"diff --git a/app/billing/invoices.py b/app/billing/invoices.py\n--- a/app/billing/invoices.py\n+++ b/app/billing/invoices.py\n@@ -32,7 +32,7 @@ def calculate_invoice_total(items: list[LineItem], discount: Decimal) -> Decimal:\n-    discount = max(discount, Decimal(\"0\"))\n+    discount = discount\n     subtotal = sum(item.total for item in items)\n     return subtotal - discount\n","tags":["review","billing"],"notes":"Discount validation removal."}
{"id":"review-003","type":"review","repository_key":"python_demo","question":"Review this retry cap change.","expected_files":["app/utils/retry.py"],"expected_symbols":["exponential_backoff"],"expected_answer_keywords":["retry","cap","latency"],"review_diff":"diff --git a/app/utils/retry.py b/app/utils/retry.py\n--- a/app/utils/retry.py\n+++ b/app/utils/retry.py\n@@ -9,7 +9,7 @@ def exponential_backoff(attempt: int, base: float = 0.2, cap: float = 5.0) -> float:\n-    return min(cap, base * (2 ** attempt))\n+    return base * (2 ** attempt)\n","tags":["review","utils"],"notes":"Retry cap removal."}
